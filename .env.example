# MongoDB Atlas Local (started through OrbStack). Leave MONGODB_URI blank to
# build the local URI from the username/password below. Paste an Atlas cloud
# connection string into MONGODB_URI if you later switch to hosted MongoDB.
MONGODB_URI=mongodb://rag:rag-local-password@localhost:27018/?authSource=admin&directConnection=true
MONGODB_ROOT_USERNAME=rag
MONGODB_ROOT_PASSWORD=rag-local-password
MONGODB_DATABASE=rag_project
MONGODB_VECTOR_INDEX=chunk_vector_index
MONGODB_TEXT_INDEX=chunk_text_index

# Local Hugging Face embedding model. Changing this after ingestion requires
# re-vectorizing every document and updating EMBEDDING_DIMENSIONS.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# How documents are cut into chunks before embedding. One of:
#   recursive    by size, at natural breaks (paragraph, line, sentence)
#   structural   one chunk per section, cut at headings
#   hybrid       at headings, then by size inside long sections
#   semantic     where the topic changes, found with the embedding model
#   contextual   cut by another strategy, then a language model adds one
#                sentence to each chunk saying what it is about (settings below)
# After changing it, restart the API and re-ingest:
#   .venv/bin/python corpus/generate/ingest.py --fresh
CHUNKING_STRATEGY=recursive

# Chunk size and overlap, in the embedding model's tokens. 0 means as many
# tokens as the model reads (256 for the default model).
CHUNK_TOKENS=0
CHUNK_OVERLAP_TOKENS=40

# Used only when CHUNKING_STRATEGY=contextual.
# The base strategy does the cutting: recursive, structural, hybrid or semantic.
CONTEXTUAL_BASE_STRATEGY=hybrid
# Where the model that writes each chunk's sentence runs:
#   local        a Hugging Face model on this machine. Free and private. The
#                model downloads on first use (about 19 GB for the default)
#                and writes one sentence per chunk, which takes hours for a
#                large corpus.
#   openrouter   a hosted model. Fast and paid: one call per chunk, with the
#                document text sent to the provider. Needs OPENROUTER_API_KEY.
CONTEXTUAL_PROVIDER=local
# The local model. Any Hugging Face chat model works. Smaller ones, for example
# HuggingFaceTB/SmolLM3-3B (about 6 GB) or microsoft/Phi-4-mini-instruct (about
# 8 GB), are faster and need less memory. Changing it downloads the new one on
# first use.
CONTEXTUAL_LOCAL_MODEL=Qwen/Qwen3.5-9B
# The hosted model, for CONTEXTUAL_PROVIDER=openrouter. Blank uses OPENROUTER_MODEL.
CONTEXTUAL_MODEL=

# Higher-quality, slower 768-dimensional alternative. Change both values together.
# EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# EMBEDDING_DIMENSIONS=768
# Optional for higher Hugging Face Hub download rate limits. Public models work without it.
HF_TOKEN=

# The hybrid pipeline reranks fused vector and full-text candidates locally.
# The default is a large model: about 8 GB to download and to hold in memory,
# and a few seconds per search. A small, fast alternative is
# cross-encoder/ms-marco-MiniLM-L-6-v2 (under 100 MB).
RERANKER_MODEL=Qwen/Qwen3-Reranker-4B
# The most tokens of question and chunk the reranker reads. A longer chunk is
# cut off there. It keeps one very long chunk from exhausting memory, which
# matters for the structural strategy, where a chunk has no size limit.
RERANKER_MAX_TOKENS=1024
RETRIEVAL_CANDIDATE_LIMIT=30
RRF_RANK_CONSTANT=60
# Each reranker spreads its scores differently: recalibrate this against the
# answerable and unanswerable evaluation cases after changing RERANKER_MODEL.
MINIMUM_RELEVANCE_SCORE=0.15

# Optional OpenRouter ambiguity check. Add your key locally and keep .env private.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Where the model that writes the answer runs:
#   openrouter   the hosted OPENROUTER_MODEL. Fast and paid, and the passages
#                are sent to the provider. Needs OPENROUTER_API_KEY.
#   local        a Hugging Face model on this machine. Free and private, and
#                much slower. The default downloads about 19 GB on first use
#                and needs that much memory.
ANSWER_PROVIDER=openrouter
# The local model. Any Hugging Face chat model works; smaller ones, for example
# microsoft/Phi-4-mini-instruct (about 8 GB), are faster and need less memory.
ANSWER_LOCAL_MODEL=Qwen/Qwen3.5-9B
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:13001
OPENROUTER_APP_NAME=Local RAG Studio
OPENROUTER_TIMEOUT_SECONDS=30
AMBIGUITY_SCORE_MARGIN=0.05
AMBIGUITY_MAX_CANDIDATES=6

# Optional LangSmith tracing. Leave false to keep traces entirely local.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-project

# Browser origin allowed to call FastAPI.
FRONTEND_ORIGIN=http://localhost:13001

# Frontend API location (copied to frontend/.env.local by `make setup`).
NEXT_PUBLIC_API_URL=http://localhost:18001
